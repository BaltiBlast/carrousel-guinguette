<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="<%= description %>" />
    <meta name="theme-color" content="#07572f" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content="<%= title %>" />
    <meta property="og:description" content="<%= description %>" />
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/index.css" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Le Carrousel",
        "description": "Guinguette, bal monté des années 70 et lieu d’événements aux Étangs du Longeau dans la Meuse.",
        "email": "lecarrousel54@gmail.com",
        "telephone": "+33681082064",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Les Étangs du Longeau",
          "postalCode": "55210",
          "addressLocality": "Hannonville-sous-les-Côtes",
          "addressCountry": "FR"
        }
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="navbar container">
        <a class="brand" href="/#accueil" aria-label="Le Carrousel — Accueil">
          <span class="brand__ornament" aria-hidden="true">❧</span>
          <span>Le Carrousel</span>
          <span class="brand__ornament" aria-hidden="true">❧</span>
        </a>

        <button class="navbar__toggle" type="button" aria-expanded="false" aria-controls="main-navigation">
          <span class="navbar__toggle-line"></span>
          <span class="navbar__toggle-line"></span>
          <span class="navbar__toggle-line"></span>
          <span class="visually-hidden">Ouvrir le menu</span>
        </button>

        <nav class="navbar__menu" id="main-navigation" data-open="false" aria-label="Navigation principale">
          <ul class="navbar__links">
            <li><a class="navbar__link" href="/#accueil">Accueil</a></li>
            <li><a class="navbar__link" href="/#programme">Programme</a></li>
            <li><a class="navbar__link" href="/#guinguette">La guinguette</a></li>
            <li><a class="navbar__link" href="/#infos">Infos pratiques</a></li>
            <li><a class="navbar__link" href="/#contact">Contact</a></li>
          </ul>
          <a class="button navbar__cta" href="/#programme">Voir le programme</a>
        </nav>
      </div>
    </header>

    <main>
      <%- body %>
    </main>

    <footer class="site-footer">
      <div class="site-footer__main container">
        <a class="brand site-footer__brand" href="/#accueil" aria-label="Le Carrousel — Retour à l’accueil">
          <span class="brand__ornament" aria-hidden="true">❧</span>
          <span>Le Carrousel</span>
          <span class="brand__ornament" aria-hidden="true">❧</span>
        </a>

        <nav class="site-footer__nav" aria-label="Navigation de pied de page">
          <ul class="site-footer__nav-list">
            <li><a class="site-footer__nav-link" href="/#accueil">Accueil</a></li>
            <li><a class="site-footer__nav-link" href="/#programme">Programme</a></li>
            <li><a class="site-footer__nav-link" href="/#guinguette">La guinguette</a></li>
            <li><a class="site-footer__nav-link" href="/#infos">Infos pratiques</a></li>
            <li><a class="site-footer__nav-link" href="/#contact">Contact</a></li>
          </ul>
        </nav>

        <address class="site-footer__contact">
          <a class="site-footer__phone" href="tel:+33681082064">06 81 08 20 64</a>
          <a href="mailto:lecarrousel54@gmail.com">lecarrousel54@gmail.com</a>
        </address>
      </div>

      <p class="site-footer__bottom container">
        © <%= currentYear %> Le Carrousel · Les Étangs du Longeau · 55210 Hannonville-sous-les-Côtes
      </p>
    </footer>

    <script type="module" src="/js/script.js"></script>
  </body>
</html>
