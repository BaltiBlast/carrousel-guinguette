<section class="location section" id="infos" aria-labelledby="location-title">
  <div class="container">
    <p class="location__eyebrow">Préparez votre venue</p>
    <h2 class="location__title" id="location-title">Retrouvez Le Carrousel</h2>

    <div class="location__layout">
      <div class="location__map">
        <iframe
          src="https://www.google.com/maps?q=Les+Etangs+du+Longeau,+55210+Hannonville-sous-les-Cotes&amp;output=embed"
          title="Localisation du Carrousel aux Étangs du Longeau"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>

      <article class="location__card" id="contact" aria-labelledby="contact-title">
        <h3 class="location__card-title" id="contact-title">Informations et contact</h3>

        <address class="location__address">
          <p>
            <strong>Le Carrousel</strong><br />
            Les Étangs du Longeau<br />
            55210 Hannonville-sous-les-Côtes
          </p>
          <p>
            <strong><%= contact.name %></strong><br />
            <a href="tel:<%= contact.phoneHref %>"><%= contact.phoneLabel %></a><br />
            <a href="mailto:<%= contact.email %>"><%= contact.email %></a>
          </p>
        </address>

        <p class="location__opening">Le Carrousel ouvre à l’occasion des événements annoncés dans le programme.</p>

        <a
          class="button location__route"
          href="https://www.google.com/maps/dir/?api=1&amp;destination=Les+Etangs+du+Longeau+Hannonville-sous-les-Cotes+55210"
          target="_blank"
          rel="noopener noreferrer"
        >
          Ouvrir l’itinéraire
        </a>
      </article>
    </div>
  </div>
</section>
