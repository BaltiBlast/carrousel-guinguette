<section class="programme section" id="programme" aria-labelledby="programme-title">
  <div class="container">
    <h2 class="programme__title" id="programme-title">Les prochains rendez-vous</h2>

    <div class="programme__grid">
      <% events.forEach((event) => { %>
        <article class="event-card" aria-labelledby="event-<%= event.slug %>-title">
          <time class="event-card__date" datetime="<%= event.date %>">
            <span class="event-card__date-day"><%= event.day %></span>
            <span class="event-card__date-month"><%= event.month %> <%= event.year %></span>
          </time>
          <h3 class="event-card__title" id="event-<%= event.slug %>-title"><%= event.title %></h3>
          <p class="event-card__meta">
            <span>
              <time datetime="<%= event.time %>"><%= event.formattedTime %></time>
              –
              <time datetime="<%= event.endTime %>"><%= event.formattedEndTime %></time>
            </span>
            <data value="<%= event.price %>"><%= event.priceLabel %></data>
          </p>
          <div class="event-card__actions">
            <a class="button event-card__link" href="/evenements/<%= event.slug %>#reservation">Réserver<span class="visually-hidden"> pour <%= event.title %></span></a>
            <a class="event-card__detail-link" href="/evenements/<%= event.slug %>">Voir le détail<span class="visually-hidden"> de <%= event.title %></span></a>
          </div>
        </article>
      <% }) %>
    </div>

    <div class="programme__footer">
      <a class="button programme__all-events" href="/evenements">Voir tout le programme</a>
    </div>
  </div>
</section>
