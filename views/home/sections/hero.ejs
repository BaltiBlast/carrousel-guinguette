<section class="hero" id="accueil" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero__main">
      <div class="hero__content">
        <p class="hero__eyebrow">Dansez au bord de l’eau</p>
        <h1 class="hero__title" id="hero-title">Le Carrousel, guinguette aux Étangs du Longeau</h1>
        <p class="hero__intro">Dansez, chantez et partagez un moment convivial.</p>
        <p class="hero__genres">Thés dansants · Musette · Reprises</p>

        <div class="hero__actions">
          <a class="button" href="/evenements">
            <svg class="button__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M7 2a1 1 0 0 1 1 1v1h8V3a1 1 0 1 1 2 0v1h1a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3h1V3a1 1 0 0 1 1-1Zm12 9H5v8a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-8ZM6 6a1 1 0 0 0-1 1v2h14V7a1 1 0 0 0-1-1H6Z"
              />
            </svg>
            Découvrir les prochaines dates
          </a>
          <a class="button button--outline" href="tel:+33681082064">
            <svg class="button__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M6.6 2.9a2 2 0 0 1 2.9.2l2.1 2.7a2 2 0 0 1-.1 2.6l-1.3 1.3a15.4 15.4 0 0 0 4.1 4.1l1.3-1.3a2 2 0 0 1 2.6-.1l2.7 2.1a2 2 0 0 1 .2 2.9l-1.2 1.2c-1.5 1.5-3.8 2-5.8 1.2A20.6 20.6 0 0 1 4.2 9.9c-.8-2-.3-4.3 1.2-5.8l1.2-1.2Z"
              />
            </svg>
            Nous appeler
          </a>
        </div>
      </div>

      <figure class="hero__visual">
        <img
          class="hero__image"
          src="/assets/img/hero-guinguette-pexels.jpg"
          alt="Des personnes dansent sous des guirlandes lumineuses lors d’une soirée en plein air"
          width="1800"
          height="1197"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    </div>

    <% if (nextEvent) { %>
      <article class="hero__next-event" aria-labelledby="next-event-title">
        <h2 class="hero__next-title" id="next-event-title">Le prochain rendez-vous</h2>
        <time class="hero__date" datetime="<%= nextEvent.date %>">
          <span class="hero__date-day"><%= nextEvent.day %></span>
          <span class="hero__date-month"><%= nextEvent.month %></span>
          <span class="hero__date-year"><%= nextEvent.year %></span>
        </time>
        <div class="hero__event-details">
          <h3 class="hero__event-name"><%= nextEvent.title %></h3>
          <p class="hero__event-meta">
            <span>
              <time datetime="<%= nextEvent.time %>"><%= nextEvent.formattedTime %></time>
              –
              <time datetime="<%= nextEvent.endTime %>"><%= nextEvent.formattedEndTime %></time>
            </span>
            <data value="<%= nextEvent.price %>"><%= nextEvent.priceLabel %></data>
          </p>
        </div>
        <a class="button" href="/evenements/<%= nextEvent.slug %>">Voir le détail</a>
      </article>
    <% } %>
  </div>
</section>
