<%- include("partials/header") %>
<div class="admin-shell">
  <%- include("partials/sidebar", { activePage: "reservations" }) %>
  <main class="admin-content admin-checkin-page">
    <a class="admin-form__back" href="/admin/reservations">← Retour aux réservations</a>
    <div class="admin-content__heading">
      <div>
        <p class="admin-content__eyebrow">Accueil des participants</p>
        <h1>Checklist des arrivées</h1>
        <p>Retrouvez rapidement une réservation et pointez le nombre réel de participants présents.</p>
      </div>
    </div>

    <% if (!event) { %>
      <p class="admin-checkin-empty">Cet événement est introuvable.</p>
    <% } else { %>
      <section class="admin-checkin" data-checkin data-expected-attendees="<%= event.expectedAttendees %>">
        <header class="admin-checkin__event">
          <div><p class="admin-content__eyebrow">Événement sélectionné</p><h2><%= event.title %></h2><p><%= event.formattedStart %></p></div>
          <a class="button button--outline" href="/evenements/<%= event.slug %>" target="_blank" rel="noopener noreferrer">Voir l’événement</a>
        </header>

        <dl class="admin-checkin__stats">
          <div><dt>Attendues</dt><dd data-checkin-expected><%= event.expectedAttendees %></dd></div>
          <div><dt>Présentes</dt><dd data-checkin-present><%= event.checkedInAttendees %></dd></div>
          <div><dt>Restantes</dt><dd data-checkin-remaining><%= event.expectedAttendees - event.checkedInAttendees %></dd></div>
        </dl>

        <div class="admin-checkin__search admin-field">
          <label for="checkin-search">Rechercher une réservation</label>
          <input id="checkin-search" type="search" placeholder="Nom, téléphone ou adresse e-mail" data-checkin-search autocomplete="off" />
          <p data-checkin-search-status role="status"><%= event.reservations.length %> réservations confirmées.</p>
        </div>

        <% if (!event.reservations.length) { %><p class="admin-checkin-empty">Aucune réservation n’a encore été acceptée pour cet événement.</p><% } %>
        <div class="admin-checkin__list">
          <% event.reservations.forEach((reservation) => { %>
            <article class="admin-checkin-entry <%= reservation.checkedIn ? 'is-checked-in' : '' %>" data-checkin-entry data-checkin-search-value="<%= `${reservation.name} ${reservation.email || ''} ${reservation.phone || ''}`.toLowerCase() %>">
              <div class="admin-checkin-entry__identity">
                <span class="admin-reservation__avatar" aria-hidden="true"><%= reservation.initials %></span>
                <div><h3><%= reservation.name %></h3><p><%= [reservation.phone, reservation.email].filter(Boolean).join(' · ') || 'Aucune coordonnée renseignée' %></p></div>
              </div>
              <form class="admin-checkin-entry__controls" action="/admin/reservations/<%= reservation.id %>/accueil" method="post">
                <label>Personnes présentes
                  <input name="attendeeCount" type="number" min="0" max="<%= reservation.seats %>" value="<%= reservation.attendeeCount %>" data-checkin-count aria-label="Nombre de personnes présentes pour <%= reservation.name %>" />
                  <small>sur <%= reservation.seats %> réservées</small>
                </label>
                <input type="hidden" name="checkedIn" value="<%= reservation.checkedIn ? 'false' : 'true' %>" />
                <button class="button <%= reservation.checkedIn ? 'button--outline' : '' %>" type="submit">
                  <%= reservation.checkedIn ? 'Annuler l’arrivée' : 'Marquer arrivé' %>
                </button>
              </form>
            </article>
          <% }) %>
        </div>
        <p class="admin-checkin__empty" data-checkin-empty hidden>Aucune réservation ne correspond à cette recherche.</p>
      </section>
    <% } %>
  </main>
</div>
