<%- include("partials/header") %>
<div class="admin-shell">
  <%- include("partials/sidebar", { activePage: "reservations" }) %>
  <main class="admin-content">
    <div class="admin-content__heading">
      <div>
        <p class="admin-content__eyebrow">Accueil des visiteurs</p>
        <h1>Réservations</h1>
        <p>Consultez les demandes et retrouvez les participants de chaque événement.</p>
      </div>
    </div>

    <section class="admin-reservation-stats" aria-label="Résumé des réservations">
      <article><span>À traiter</span><strong><%= counts.pending %></strong></article>
      <article><span>Acceptées</span><strong><%= counts.accepted %></strong></article>
      <article><span>Refusées</span><strong><%= counts.rejected %></strong></article>
      <article><span>Total</span><strong><%= counts.total %></strong></article>
    </section>

    <div class="admin-reservation-toolbar" data-reservation-filters>
      <div class="admin-filters" aria-label="Filtrer les réservations">
        <button type="button" data-reservation-filter="all" aria-pressed="true">Toutes</button>
        <button type="button" data-reservation-filter="pending" aria-pressed="false">À traiter</button>
        <button type="button" data-reservation-filter="accepted" aria-pressed="false">Acceptées</button>
        <button type="button" data-reservation-filter="rejected" aria-pressed="false">Refusées</button>
      </div>
      <p data-reservation-filter-status role="status"><%= counts.total %> réservations affichées.</p>
    </div>

    <div class="admin-reservation-events">
      <% if (!events.length) { %><p class="admin-reviews__empty">Aucun événement ne possède de réservation.</p><% } %>
      <% events.forEach((event, eventIndex) => { %>
        <details class="admin-reservation-event" id="reservations-<%= event.slug %>" name="reservation-events" data-reservation-event <%= eventIndex === 0 ? 'open' : '' %>>
          <summary class="admin-reservation-event__summary">
            <div>
              <p class="admin-content__eyebrow"><%= event.formattedStart %></p>
              <h2><%= event.title %></h2>
            </div>
            <div class="admin-reservation-event__summary-counts">
              <span><strong><%= event.reservations.length %></strong> réservations</span>
              <span><strong><%= event.reservations.filter(({ status }) => status === 'pending').length %></strong> à traiter</span>
              <span><strong><%= event.remainingSeats %></strong> places restantes</span>
            </div>
          </summary>
          <div class="admin-reservation-event__body">
            <div class="admin-reservation-event__links">
              <a class="button" href="/admin/reservations/accueil?eventId=<%= event.id %>">Faire l’accueil</a>
              <a class="button button--outline" href="/evenements/<%= event.slug %>" target="_blank" rel="noopener noreferrer">Voir l’événement</a>
            </div>
            <dl class="admin-reservation-capacity">
              <div><dt>Capacité</dt><dd><%= event.capacity %></dd></div>
              <div><dt>Confirmées</dt><dd><%= event.confirmedSeats %></dd></div>
              <div><dt>Demandées</dt><dd><%= event.pendingSeats %></dd></div>
              <div><dt>Restantes</dt><dd><%= event.remainingSeats %></dd></div>
            </dl>

            <div class="admin-reservation-list">
            <% event.reservations.forEach((reservation) => { %>
              <article class="admin-reservation" data-reservation-status="<%= reservation.status %>">
                <header class="admin-reservation__header">
                  <span class="admin-reservation__avatar" aria-hidden="true"><%= reservation.initials %></span>
                  <div><h3><%= reservation.name %></h3><p>Demande du <%= reservation.requestedAt %></p></div>
                  <span class="admin-reservation__badge admin-reservation__badge--<%= reservation.status %>"><%= reservation.statusLabel %></span>
                </header>
                <dl class="admin-reservation__details">
                  <div><dt>Places</dt><dd><strong><%= reservation.seats %></strong></dd></div>
                  <div><dt>E-mail</dt><dd><a href="mailto:<%= reservation.email %>"><%= reservation.email %></a></dd></div>
                  <div><dt>Téléphone</dt><dd><a href="tel:<%= reservation.phone.replace(/\s/g, '') %>"><%= reservation.phone %></a></dd></div>
                </dl>
                <% if (reservation.rejectionReason) { %><div class="admin-reservation__reason"><strong>Motif du refus</strong><p><%= reservation.rejectionReason %></p></div><% } %>
                <div class="admin-reservation__actions">
                  <% if (reservation.status === 'pending') { %>
                    <form action="/admin/reservations/<%= reservation.id %>/statut" method="post"><input type="hidden" name="status" value="accepted" /><button class="button" type="submit">Accepter</button></form>
                    <form action="/admin/reservations/<%= reservation.id %>/statut" method="post"><input type="hidden" name="status" value="rejected" /><button class="button button--outline admin-reservation__reject" type="submit">Refuser</button></form>
                  <% } else { %>
                    <form action="/admin/reservations/<%= reservation.id %>/statut" method="post"><input type="hidden" name="status" value="pending" /><button class="button button--outline" type="submit">Repasser en attente</button></form>
                  <% } %>
                </div>
              </article>
            <% }) %>
            </div>
          </div>
        </details>
      <% }) %>
    </div>

  </main>
</div>
