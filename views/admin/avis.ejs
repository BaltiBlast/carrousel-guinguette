<%- include("partials/header") %>

<div class="admin-shell">
  <%- include("partials/sidebar", { activePage: "dashboard" }) %>

  <main class="admin-content">
    <div class="admin-content__heading">
      <div>
        <p class="admin-content__eyebrow">Administration</p>
        <h1>Livre d’or</h1>
        <p>Consultez et modérez les avis déposés sur le site du Carrousel.</p>
      </div>
    </div>

    <section class="admin-stats" id="avis-livre-d-or" aria-label="Résumé des avis">
      <article class="admin-stat admin-stat--pending">
        <span>En attente</span>
        <strong><%= counts.pending %></strong>
      </article>
      <article class="admin-stat admin-stat--published">
        <span>Publiés</span>
        <strong><%= counts.published %></strong>
      </article>
      <article class="admin-stat admin-stat--rejected">
        <span>Refusés</span>
        <strong><%= counts.rejected %></strong>
      </article>
    </section>

    <% if (actionMessage) { %>
      <p class="admin-action-message" role="status"><%= actionMessage %></p>
    <% } %>

    <section class="admin-reviews" aria-labelledby="reviews-title">
      <div class="admin-reviews__heading">
        <div>
          <p class="admin-content__eyebrow">Modération</p>
          <h2 id="reviews-title">Gestion des avis</h2>
        </div>
        <div class="admin-filters" aria-label="Filtrer les avis" data-review-filters>
          <button type="button" data-review-filter="all" aria-pressed="true">Tous</button>
          <button type="button" data-review-filter="pending" aria-pressed="false">En attente</button>
          <button type="button" data-review-filter="published" aria-pressed="false">Publiés</button>
          <button type="button" data-review-filter="rejected" aria-pressed="false">Refusés</button>
        </div>
      </div>

      <div class="admin-reviews__list">
        <% if (reviews.length === 0) { %>
          <p class="admin-reviews__empty">Aucun avis n’a encore été déposé.</p>
        <% } %>
        <% reviews.forEach((review) => { %>
          <article class="admin-review" data-review-status="<%= review.status %>">
            <div class="admin-review__avatar" aria-hidden="true"><%= review.initials %></div>
            <div class="admin-review__body">
              <div class="admin-review__header">
                <div>
                  <h3><%= review.author %></h3>
                  <p class="admin-review__date">Visite du <%= review.visitDate %> · Reçu <%= review.submittedAt.toLowerCase() %></p>
                </div>
                <span class="admin-status admin-status--<%= review.status %>"><%= review.statusLabel %></span>
              </div>
              <p class="admin-review__rating" aria-label="<%= review.rating %> étoiles sur 5">
                <% for (let star = 1; star <= 5; star += 1) { %><span class="<%= star <= review.rating ? 'is-filled' : '' %>" aria-hidden="true">★</span><% } %>
              </p>
              <blockquote class="admin-review__comment"><%= review.comment %></blockquote>
              <% if (review.status !== "published") { %>
                <div class="admin-review__actions">
                  <form action="/admin/avis/<%= review.id %>/publier" method="post">
                    <input name="filter" type="hidden" value="all" data-review-form-filter />
                    <button class="button" type="submit">Publier l’avis</button>
                  </form>
                  <% if (review.status === "pending") { %>
                    <form action="/admin/avis/<%= review.id %>/refuser" method="post">
                      <input name="filter" type="hidden" value="all" data-review-form-filter />
                      <button class="button button--outline admin-review__reject" type="submit">Refuser</button>
                    </form>
                  <% } %>
                </div>
              <% } else { %>
                <div class="admin-review__actions">
                  <form action="/admin/avis/<%= review.id %>/refuser" method="post">
                    <input name="filter" type="hidden" value="all" data-review-form-filter />
                    <button class="button button--outline admin-review__reject" type="submit">Retirer et refuser l’avis</button>
                  </form>
                </div>
              <% } %>
            </div>
          </article>
        <% }) %>
        <p class="admin-reviews__empty" data-review-filter-empty hidden>Aucun avis ne correspond à ce filtre.</p>
        <p class="visually-hidden" aria-live="polite" data-review-filter-status></p>
      </div>
    </section>
  </main>
</div>
