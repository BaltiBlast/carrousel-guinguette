<main class="admin-login">
  <a class="admin-brand" href="/" aria-label="Le Carrousel, retour au site">
    <span aria-hidden="true">❧</span>
    <span>Le Carrousel</span>
    <span aria-hidden="true">❧</span>
  </a>

  <section class="admin-login__card" aria-labelledby="login-title">
    <div class="admin-login__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24">
        <path d="M4 5a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v14a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V5Zm3-1a1 1 0 0 0-1 1v1.4l6 4.3 6-4.3V5a1 1 0 0 0-1-1H7Zm11 4.9-5.4 3.8a1 1 0 0 1-1.2 0L6 8.9V19a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V8.9Z" />
      </svg>
    </div>
    <p class="admin-login__eyebrow">Espace réservé</p>
    <h1 class="admin-login__title" id="login-title">Connexion à l’administration</h1>
    <p class="admin-login__intro">
      Cet espace est réservé à l’équipe du Carrousel. Si vous êtes administrateur, saisissez l’adresse e-mail
      associée à votre compte pour recevoir un lien sécurisé.
    </p>

    <% if (message) { %>
      <p class="admin-login__notice admin-login__notice--success" role="status"><%= message %></p>
    <% } %>
    <% if (error) { %>
      <p class="admin-login__notice admin-login__notice--error" role="alert"><%= error %></p>
    <% } %>

    <form class="admin-login__form" action="/admin/connexion" method="post">
      <div class="admin-field">
        <label for="email">Adresse e-mail</label>
        <input id="email" name="email" type="email" autocomplete="email" maxlength="254" placeholder="vous@exemple.fr" required />
      </div>
      <button class="button" type="submit">Recevoir mon lien de connexion</button>
    </form>

    <p class="admin-login__help">Le lien sera utilisable une seule fois et pendant une durée limitée.</p>
  </section>

  <a class="admin-login__back" href="/">Vous n’êtes pas administrateur ? Retourner au site</a>
</main>
