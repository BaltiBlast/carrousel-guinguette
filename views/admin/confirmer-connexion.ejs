<main class="admin-login">
  <a class="admin-brand" href="/" aria-label="Le Carrousel — Retour au site">
    <span aria-hidden="true">❧</span>
    <span>Le Carrousel</span>
    <span aria-hidden="true">❧</span>
  </a>

  <section class="admin-login__card" aria-labelledby="confirmation-title">
    <div class="admin-login__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24">
        <path d="M12 2a7 7 0 0 1 7 7v2h1a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h1V9a7 7 0 0 1 7-7Zm5 9V9A5 5 0 0 0 7 9v2h10Zm-5 4a2 2 0 0 0-1 3.7V20h2v-1.3A2 2 0 0 0 12 15Z" />
      </svg>
    </div>
    <p class="admin-login__eyebrow">Lien sécurisé</p>
    <h1 class="admin-login__title" id="confirmation-title">Confirmer la connexion</h1>

    <% if (error) { %>
      <p class="admin-login__notice admin-login__notice--error" role="alert"><%= error %></p>
      <a class="button admin-login__primary-action" href="/admin/connexion">Demander un nouveau lien</a>
    <% } else { %>
      <p class="admin-login__intro">
        Cliquez sur le bouton ci-dessous pour ouvrir votre session d’administration.
      </p>
      <form class="admin-login__form" action="/admin/connexion/lien" method="post">
        <input name="token" type="hidden" value="<%= token %>" />
        <button class="button" type="submit">Me connecter</button>
      </form>
    <% } %>
  </section>

  <a class="admin-login__back" href="/">← Retour au site</a>
</main>
